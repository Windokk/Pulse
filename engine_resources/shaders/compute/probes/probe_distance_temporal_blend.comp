#version 430 core

// Distance-atlas counterpart of probe_temporal_blend.comp - identical exponential blend logic, just
// declared against rg16f (mean hit distance, mean hit distance^2) instead of rgba16f (irradiance). Can't
// share the same shader/pipeline as probe_temporal_blend.comp : GL requires an image2D's declared format
// qualifier to match the bound texture's actual internal format, and ProbeManager::Update() needs to
// dispatch this blend against both the RGBA16F irradiance atlas and the RG16F distance atlas every frame
// (see ProbeManager::m_DistanceTemporalBlendPipeline).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Sampler binding starts at 45 - see the identical comment in probe_trace.comp for why (avoids
// GLStateCache going stale on lit.frag's material texture units 1-3, since ProbeManager::Update()'s raw
// Texture2D::Bind() runs every frame ahead of the forward pass).
layout(binding = 45) uniform sampler2D uFresh;
layout(rg16f, binding = 0) uniform image2D uPublished;

uniform int uAtlasSize;
uniform float uHysteresis;

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint size = uint(uAtlasSize);
    uint totalTexels = size * size;
    if (gid >= totalTexels)
        return;

    ivec2 coord = ivec2(int(gid % size), int(gid / size));

    vec2 fresh = texelFetch(uFresh, coord, 0).rg;
    vec2 prev = imageLoad(uPublished, coord).rg;
    vec2 blended = mix(fresh, prev, uHysteresis);

    imageStore(uPublished, coord, vec4(blended, 0.0, 0.0));
}
