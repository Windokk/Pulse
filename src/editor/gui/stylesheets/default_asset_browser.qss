QWidget {
    background-color: #1d1d1d;
    border-bottom: 1px solid #6e6e6e;
}

/* BREADCRUMB BUTTONS */
QPushButton {
    color: #d0d0d0;
    background: transparent;
    border: none;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    color: #ffffff;
    background-color: #2a2a2a;
    border-radius: 0px;
}

QPushButton:pressed {
    background-color: #353535;
}

/* SEPARATORS ("/") */
QLabel {
    color: #555555;
    font-size: 13px;
    padding: 0px 4px;
    border-bottom: none;
}