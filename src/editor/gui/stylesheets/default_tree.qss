/* --- Global Tree View --- */
QTreeView {
    background-color: transparent;
    color: #e0e0e0;
    border: 1px solid #2b2b2b;
    font-family: "Segoe UI", "Roboto", "Noto Sans", sans-serif;
    font-size: 12px;
    show-decoration-selected: 0;
    outline: 0;
}

/* --- Tree Branches --- */
QTreeView::branch {
    background: transparent;
    border-image: none;
}

/* Lines connecting tree branches */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/pulse/default/icons/chevron_right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/pulse/default/icons/chevron_down.svg);
}

QTreeView::branch:hover {
    background-color: #2a2a2a;
}

/* --- Items --- */
QTreeView::item {
    padding: 3px 6px;
    border: none;
}

QTreeView::item:hover {
    background-color: #2a2a2a;
}

QTreeView::item:selected {
    background-color: #3a3a3a;
    color: #ffffff;
}

QTreeView::item:selected:active {
    background-color: #4a4a4a;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: #1b1b1b;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #333;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #444;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Header (if visible) --- */
QHeaderView::section {
    background-color: #1b1b1b;
    color: #aaa;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #2b2b2b;
}

/* --- Selection outline (keyboard focus) --- */
QTreeView:focus {
    border: 1px solid #3c3c3c;
}
